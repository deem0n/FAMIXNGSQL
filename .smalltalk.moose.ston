SmalltalkCISpec {
    #name : 'FAMIXNGSQL-2-Pharo13-Moose13',
    #preLoading : 'scripts/ci/prepare-moose.st',
    #loading : [
        SCIMetacelloLoadSpec {
            #baseline : 'MooseIDE',
            #repository : 'github://deem0n/MooseIDE:0078da66db3575346e3a25402a90684686234f07/src',
            #load : [ 'default' ],
            #onConflict : #useIncoming,
            #onUpgrade : #useIncoming,
            #platforms : [ #pharo ]
        },
        SCIMetacelloLoadSpec {
            #baseline : 'FAMIXNGSQL',
            #directory : 'src',
            #load : [ 'Tests', 'GeneratorTests', 'MooseIDETests' ],
            #onConflict : #useIncoming,
            #onUpgrade : #useIncoming,
            #platforms : [ #pharo ]
        }
    ],
    #preTesting : 'scripts/ci/configure-database.st',
    #testing : {
        #packages : [ 'FamixNGSQL-Importer-Tests', 'FAMIXNGSQLMetamodelGenerator-Tests', 'PgMetadata-tests', 'FamixNGSQL-MooseIDE-Tests' ],
        #classes : [ #MiMetaBrowserRegressionTest, #MiModelReportRegressionTest, #MiLayerApplicabilityTest, #MiApplicationTest, #MiButterflyMapModelTest, #MiButterflyMapBrowserTest, #MooseGroupNameCloudTest, #MQNavigationContainmentTest ],
        #defaultTimeout : 120,
        #failOnZeroTests : true
    }
}
